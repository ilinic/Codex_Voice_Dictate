<Window x:Class="CodexVoiceDictate.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Voice Dictate — Settings"
        Width="820" Height="760" MinWidth="460" MinHeight="440"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#162436" />
        </Style>
        <Style x:Key="FieldHeading" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#263747" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#586879" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#E2E7EE" BorderThickness="0,0,0,1" Padding="24,16">
            <StackPanel>
                <TextBlock Text="Dictation settings" FontSize="21" FontWeight="SemiBold" Foreground="#162436" />
                <TextBlock Text="Configure the microphone workflow, language recognition and shortcuts."
                           Style="{StaticResource Hint}" Margin="0,3,0,0" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,18,24,18">
                <Border Background="White" BorderBrush="#E2E7EE" BorderThickness="1" CornerRadius="10"
                        Padding="20" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Connection" Style="{StaticResource SectionHeading}" />
                        <TextBlock Text="OpenAI API key" Style="{StaticResource FieldHeading}" Margin="0,15,0,7" />
                        <PasswordBox x:Name="ApiKeyBox" />
                        <TextBlock Text="Stored encrypted for this Windows user. Leave blank to use OPENAI_API_KEY."
                                   Style="{StaticResource Hint}" Margin="0,9,0,0" />
                        <Separator Margin="0,17,0,14" Background="#E2E7EE" />
                        <TextBlock Text="Dictation target" Style="{StaticResource FieldHeading}" />
                        <CheckBox x:Name="PasteToFocusedFieldBox" Content="Paste into the focused field (no binding)"
                                  Margin="0,10,0,0" Checked="DirectPasteModeChanged" Unchecked="DirectPasteModeChanged" />
                        <TextBlock Text="Focus the destination before recording and keep it focused until insertion finishes. Stop and send submits without text verification."
                                   Style="{StaticResource Hint}" Margin="0,7,0,0" />
                        <StackPanel x:Name="BoundTargetPanel" Margin="0,12,0,0">
                            <TextBlock x:Name="BoundTargetInfo" Style="{StaticResource Hint}" />
                            <TextBlock Text="When direct paste is off: focus a field and press Ctrl+Alt+B to bind it."
                                       Style="{StaticResource Hint}" Margin="0,5,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="White" BorderBrush="#E2E7EE" BorderThickness="1" CornerRadius="10"
                        Padding="20" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Speech recognition" Style="{StaticResource SectionHeading}" />
                        <TextBlock Text="Languages" Style="{StaticResource FieldHeading}" Margin="0,15,0,3" />
                        <TextBlock Text="Choose languages, or leave everything unchecked for automatic detection."
                                   Style="{StaticResource Hint}" Margin="0,0,0,12" />
                        <WrapPanel x:Name="LanguagesPanel" />
                        <TextBlock Text="Recognition context" Style="{StaticResource FieldHeading}" Margin="0,10,0,5" />
                        <TextBlock Text="Describe the project and the exact spelling of names or abbreviations. Sent with each transcription; leave blank for no extra context."
                                   Style="{StaticResource Hint}" Margin="0,0,0,8" />
                        <TextBox x:Name="RecognitionContextBox" Height="104" MaxLength="1200" AcceptsReturn="True"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                        <Separator Margin="0,8,0,17" Background="#E2E7EE" />
                        <CheckBox x:Name="CorrectionEnabled" Content="Correct technical terms and punctuation"
                                  FontWeight="SemiBold" />
                        <TextBlock Text="Correction model" Style="{StaticResource FieldHeading}" Margin="0,14,0,7" />
                        <ComboBox x:Name="CorrectionModelBox"
                                  IsEnabled="{Binding IsChecked, ElementName=CorrectionEnabled}" />
                    </StackPanel>
                </Border>

                <Border Background="White" BorderBrush="#E2E7EE" BorderThickness="1" CornerRadius="10" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Dictation controls" Style="{StaticResource SectionHeading}" />
                        <Grid Margin="0,15,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Start / stop · insert" Style="{StaticResource FieldHeading}" Margin="0,0,0,7" />
                                <TextBox x:Name="InsertShortcutBox" IsReadOnly="True" Cursor="Hand"
                                         ToolTip="Click here and press a shortcut" PreviewKeyDown="OnShortcutKeyDown" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Stop and send" Style="{StaticResource FieldHeading}" Margin="0,0,0,7" />
                                <TextBox x:Name="SendShortcutBox" IsReadOnly="True" Cursor="Hand"
                                         ToolTip="Click here and press a shortcut" PreviewKeyDown="OnShortcutKeyDown" />
                            </StackPanel>
                        </Grid>
                        <CheckBox x:Name="NotificationsEnabled" Content="Show tray notifications" Margin="0,19,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="White" BorderBrush="#E2E7EE" BorderThickness="0,1,0,0" Padding="24,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" MinWidth="108" Padding="18,9"
                        Margin="0,0,10,0" Background="White" BorderBrush="#CBD5E1" />
                <Button Content="Save" IsDefault="True" MinWidth="108" Padding="18,9"
                        Background="#176DC1" Foreground="White" BorderBrush="#176DC1"
                        FontWeight="SemiBold" Click="SaveClicked" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
